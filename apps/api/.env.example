ENVIRONMENT=development
LOG_LEVEL=INFO

# Banco principal (formato libpq; para Neon, inclua ?sslmode=require).
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus

# Banco usado pelos testes de integração. Os testes APAGAM os dados dele.
TEST_DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus_test

# Origem do front-end, aceita em requisições que alteram dados.
WEB_ORIGIN=http://localhost:3000

# Senha do administrador da organização de demonstração (python -m app.cli seed-demo).
# Se ficar vazia, uma senha é gerada e exibida uma única vez.
SEED_ADMIN_PASSWORD=

# Embeddings: "hashing" (local, sem custo, só para desenvolvimento) ou "voyage".
EMBEDDING_PROVIDER=hashing
VOYAGE_API_KEY=

# Respostas: "extractive" (sem IA, cita o trecho mais relevante) ou "gemini".
ANSWER_PROVIDER=extractive
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Processamento de documentos dentro do processo da API (útil em hospedagem gratuita).
RUN_WORKER_IN_API=false

# Arquivos enviados. "local" grava em disco (desenvolvimento); "s3" usa Cloudflare R2, AWS S3
# ou MinIO. O disco de hospedagens gratuitas é apagado a cada reinício, então use "s3" lá.
STORAGE_BACKEND=local
# Só para STORAGE_BACKEND=s3. No R2: https://<ID_DA_CONTA>.r2.cloudflarestorage.com, região "auto".
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
