ENVIRONMENT=development
LOG_LEVEL=INFO

# Banco principal (formato libpq; para Neon, inclua ?sslmode=require).
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus

# Banco usado pelos testes de integração. Os testes APAGAM os dados dele.
TEST_DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus_test

# Origem do front-end, aceita em requisições que alteram dados.
WEB_ORIGIN=http://localhost:3000

# Senha do administrador da organização de demonstração (python -m app.cli seed-demo).
# Se ficar vazia, uma senha é gerada e exibida uma única vez.
SEED_ADMIN_PASSWORD=
